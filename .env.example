# Server
PORT=8080

# Wake-on-LAN target
WAKE_MAC=00:11:22:33:44:55
WAKE_BROADCAST=255.255.255.255
WAKE_PORT=9

# Sleep listener target
SLEEP_HOST=192.168.1.50
# SSH config
SSH_PORT=22
SSH_USER=root
SSH_PASS=CHANGE_ME
# Command run over SSH
SLEEP_COMMAND=/usr/sbin/ethtool -s nic0 wol g && /bin/systemctl suspend

# TCP wake proxy / redirector
# Routes can come from PROXY_TARGETS, Nginx Proxy Manager discovery, or the
# PROXY_PORTS + PROXY_TARGET_HOST fallback. If the remote port is unavailable,
# the app sends Wake-on-LAN and waits until that TCP port accepts connections.
PROXY_ENABLED=false
PROXY_LISTEN_HOST=0.0.0.0
PROXY_PORTS=2222,6790,9000
# Optional explicit per-port targets. When set, these routes do not need
# PROXY_TARGET_HOST and can point to different hosts/VMs/LXCs.
# Format: localPort=targetHost:targetPort,localPort=targetHost:targetPort
PROXY_TARGETS=
PROXY_TARGET_HOST=192.168.1.50
PROXY_CONNECT_TIMEOUT_MS=1500
PROXY_WAKE_CACHE_MS=300000
PROXY_WAKE_TIMEOUT_MS=120000
PROXY_RETRY_DELAY_MS=2000

# Optional Proxmox guest start after Wake-on-LAN, for routes that include
# guest metadata from Nginx Proxy Manager Advanced comments.
PROXY_GUEST_START_ENABLED=false
PROXY_GUEST_START_TIMEOUT_MS=120000
PROXY_GUEST_START_RETRY_DELAY_MS=3000

# Optional Nginx Proxy Manager discovery. Mount the NPM data directory read-only
# into this container and point NPM_SQLITE_PATH to database.sqlite.
NPM_DISCOVERY_ENABLED=false
NPM_SQLITE_PATH=/npm-data/database.sqlite
NPM_SQLITE_COMMAND=sqlite3
# Optional filter. Leave empty to accept any active NPM proxy host that has the
# Advanced marker. Example: wake-sleep,127.0.0.1
NPM_DISCOVERY_FORWARD_HOSTS=
NPM_DISCOVERY_COMMENT_PREFIX=wake-sleep

PROXY_IDLE_SLEEP_ENABLED=false
PROXY_IDLE_SLEEP_TIMEOUT_MS=1800000
PROXY_IDLE_SLEEP_REQUIRE_NO_CONNECTIONS=true
PROXY_IDLE_SLEEP_COMMAND=
PROXY_IDLE_REMOTE_CHECK_ENABLED=true
PROXY_IDLE_REMOTE_CHECK_SECONDS=120
PROXY_IDLE_REMOTE_CPU_MAX_PERCENT=10
PROXY_IDLE_REMOTE_NET_MAX_BYTES_PER_SECOND=4096
PROXY_IDLE_REMOTE_NET_INTERFACES=
PROXY_IDLE_REMOTE_NET_EXCLUDE_REGEX=^lo$

# Persistence
STATE_DIR=./data
LOG_PERSIST_ENABLED=true
LOG_MAX_ENTRIES=200
PROXY_USAGE_LOG_ENABLED=true
PROXY_USAGE_LOG_MAX_ENTRIES=200
